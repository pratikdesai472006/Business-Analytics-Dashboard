# Create a MongoDB Atlas cluster and paste its connection string here.
MONGODB_URI=
JWT_SECRET=
PORT=5000
# Your deployed Vercel URL. Multiple origins may be comma-separated.
# Example: CLIENT_ORIGIN=https://your-project.vercel.app,https://another-site.example.com
# Use * to allow all origins (not recommended for production).
CLIENT_ORIGIN=https://your-project.vercel.app

# Optional: enable real reminder emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@example.com
